{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "schedule:weekly",
    "schedule:automergeOfficeHours"
  ],
  "lockFileMaintenance": {
    "enabled": false, // Disabled in favor of exact pinning and digesting
    "automerge": true,
    "extends": [
      "schedule:monthly"
    ]
  },
  "packageRules": [
    {
      "description": "Pin Docker digests",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "schedule": [
        "* 0-3 1 * *" // 1st of every month, early morning
      ]
    },
    {
      "description": "Reschedule packages updated too frequently",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "taiki-e/install-action"
      ],
      "schedule": [
        "* 8-17 1 * *" // Office hours, every month
      ]
    }
  ]
}
