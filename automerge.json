{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "Automerge pins and digests",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge trusted GitHub Actions updates",
      "groupName": "Trusted GitHub Actions (non-major)",
      "groupSlug": "trusted-github-actions",
      "schedule": [
        "* 9-17 1 * *"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*",
        "astral-sh/setup-uv",
        "aws-actions/*",
        "codecov/codecov-action",
        "docker/*",
        "pnpm/action-setup",
        "PyO3/maturin-action",
        "pypa/gh-action-pypi-publish"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge trusted Python dependencies",
      "groupName": "Trusted Python (non-major)",
      "groupSlug": "trusted-python",
      "schedule": [
        "* 9-17 1 * *"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "boto3",
        "botocore",
        "django",
        "ruff",
        "s3transfer"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge trusted Node.js dependencies",
      "groupName": "Trusted Node.js (non-major)",
      "groupSlug": "trusted-node",
      "schedule": [
        "* 9-17 1 * *"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "@aws-sdk/*",
        "svelte",
        "vite"
      ],
      "automerge": true
    },
    {
      "description": "Group and automerge trusted Rust dependencies",
      "groupName": "Trusted Rust (non-major)",
      "groupSlug": "trusted-rust",
      "schedule": [
        "* 9-17 1 * *"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "serde",
        "serde_derive",
        "serde_json",
        "tokio",
        "log"
      ],
      "automerge": true
    },
    {
      "description": "Approve major upgrades before creating separate PRs",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null,
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
